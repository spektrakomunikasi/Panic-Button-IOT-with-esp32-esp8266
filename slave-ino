#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <ESP8266HTTPClient.h>
#include <EEPROM.h>
#include <ArduinoJson.h>

// ================== PIN ==================
#define BTN_PIN D5           // tombol NO ke GND (INPUT_PULLUP)
#define LED_PIN D6           // LED status opsional (HIGH=ON)
#define CFG_PIN D3           // tombol config opsional ke GND (hold 5 detik)

// ================== EEPROM ==================
#define EEPROM_SIZE 512
#define CFG_VALID 0xA5

struct ConfigData {
  char ssid[32];
  char pass[64];
  char masterIp[16];
  char location[32];
  uint8_t slaveId;
  uint8_t valid;
};

ConfigData cfg;
ESP8266WebServer server(80);

bool apMode = false;
String apName;

unsigned long pressStart = 0;
bool panicSent = false;
bool clearSent = false;
unsigned long lastHeartbeat = 0;
unsigned long lastWifiRetry = 0;

// ================== UTIL ==================
void loadConfig() {
  EEPROM.begin(EEPROM_SIZE);
  EEPROM.get(0, cfg);
  if (cfg.valid != CFG_VALID) {
    memset(&cfg, 0, sizeof(cfg));
    cfg.slaveId = 1;
    cfg.valid = 0;
  }
}

void saveConfig() {
  cfg.valid = CFG_VALID;
  EEPROM.put(0, cfg);
  EEPROM.commit();
}

void clearConfig() {
  memset(&cfg, 0, sizeof(cfg));
  cfg.slaveId = 1;
  cfg.valid = 0;
  EEPROM.put(0, cfg);
  EEPROM.commit();
}

bool isLikelyIPv4(const String& ip) {
  int dots = 0;
  for (size_t i = 0; i < ip.length(); i++) {
    char c = ip[i];
    if (c == '.') dots++;
    else if (!isDigit(c)) return false;
  }
  return (dots == 3 && ip.length() >= 7 && ip.length() <= 15);
}

String subnetHint() {
  if (WiFi.status() != WL_CONNECTED) return "-";
  IPAddress my = WiFi.localIP();
  return String(my[0]) + "." + String(my[1]) + "." + String(my[2]) + ".x";
}

// ================== MASTER COMM ==================
bool sendEvent(const String& ev) {
  if (WiFi.status() != WL_CONNECTED) return false;
  if (strlen(cfg.masterIp) < 7) return false;

  WiFiClient client;
  HTTPClient http;
  String url = "http://" + String(cfg.masterIp) + "/api/event";

  if (!http.begin(client, url)) return false;
  http.addHeader("Content-Type", "application/json");

  StaticJsonDocument<200> doc;
  doc["slave_id"] = cfg.slaveId;
  doc["location"] = String(cfg.location);
  doc["event"] = ev;

  String body;
  serializeJson(doc, body);

  int code = http.POST(body);
  http.end();

  return (code > 0 && code < 300);
}

// ================== WIFI ==================
bool connectSTA() {
  if (strlen(cfg.ssid) == 0) return false;

  WiFi.mode(WIFI_STA);
  WiFi.begin(cfg.ssid, cfg.pass);

  Serial.printf("Connecting to SSID: %s\n", cfg.ssid);

  for (int i = 0; i < 30; i++) { // ~15 detik
    if (WiFi.status() == WL_CONNECTED) {
      Serial.print("WiFi connected. IP: ");
      Serial.println(WiFi.localIP());
      return true;
    }
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connect failed");
  return false;
}

// ================== AP SETUP WEB ==================
String htmlHeader(const String& title) {
  String s = "<!doctype html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'>";
  s += "<title>" + title + "</title>";
  s += "<style>body{font-family:Arial;margin:16px;} input,select,button{padding:8px;margin:4px 0;width:100%;max-width:420px;} .card{border:1px solid #ccc;border-radius:8px;padding:12px;margin:10px 0;} .ok{background:#e7ffe7;} .warn{background:#fff5dd;}</style>";
  s += "</head><body>";
  return s;
}

void handleSetupPage() {
  int n = WiFi.scanNetworks();
  String page = htmlHeader("Slave Setup");
  page += "<h3>Setup Slave Panic (ESP8266)</h3>";
  page += "<div class='card warn'><b>Mode:</b> AP Setup<br>";
  page += "SSID AP: <b>" + apName + "</b><br>";
  page += "IP setup: <b>192.168.4.1</b></div>";

  page += "<form method='POST' action='/save'>";
  page += "<label>SSID WiFi (harus sama subnet master)</label><br>";
  page += "<input name='ssid' value='" + String(cfg.ssid) + "' placeholder='Nama WiFi'>";

  if (n > 0) {
    page += "<label>Pilih SSID terdeteksi</label><br><select onchange=\"document.getElementsByName('ssid')[0].value=this.value\">";
    page += "<option value=''>-- pilih SSID --</option>";
    for (int i = 0; i < n; i++) {
      page += "<option value='" + WiFi.SSID(i) + "'>" + WiFi.SSID(i) + " (RSSI " + String(WiFi.RSSI(i)) + ")</option>";
    }
    page += "</select>";
  }

  page += "<label>Password WiFi</label><br>";
  page += "<input name='pass' type='password' value='" + String(cfg.pass) + "' placeholder='password wifi'>";

  page += "<label>IP Master (contoh 192.168.1.50)</label><br>";
  page += "<input name='master' value='" + String(cfg.masterIp) + "' placeholder='192.168.1.50'>";

  page += "<label>Slave ID (1-3)</label><br>";
  page += "<input name='id' type='number' min='1' max='3' value='" + String(cfg.slaveId) + "'>";

  page += "<label>Nama Lokasi</label><br>";
  page += "<input name='loc' value='" + String(cfg.location) + "' placeholder='Gudang / Lobi / Server'>";

  page += "<br><button type='submit'>Simpan & Reboot</button></form>";

  page += "<div class='card'>";
  page += "<a href='/test'>Test koneksi ke Master sekarang</a><br>";
  page += "<a href='/clear' onclick=\"return confirm('Hapus config?')\">Clear config</a>";
  page += "</div>";

  page += "</body></html>";
  server.send(200, "text/html", page);
}

void handleSave() {
  String ssid = server.arg("ssid");
  String pass = server.arg("pass");
  String master = server.arg("master");
  String loc = server.arg("loc");
  int id = server.arg("id").toInt();

  if (ssid.length() < 1) {
    server.send(400, "text/plain", "SSID wajib diisi");
    return;
  }
  if (!isLikelyIPv4(master)) {
    server.send(400, "text/plain", "IP Master tidak valid");
    return;
  }
  if (loc.length() < 1) {
    server.send(400, "text/plain", "Nama lokasi wajib diisi");
    return;
  }
  if (id < 1 || id > 3) {
    server.send(400, "text/plain", "Slave ID harus 1..3");
    return;
  }

  memset(&cfg, 0, sizeof(cfg));
  ssid.toCharArray(cfg.ssid, sizeof(cfg.ssid));
  pass.toCharArray(cfg.pass, sizeof(cfg.pass));
  master.toCharArray(cfg.masterIp, sizeof(cfg.masterIp));
  loc.toCharArray(cfg.location, sizeof(cfg.location));
  cfg.slaveId = (uint8_t)id;
  cfg.valid = CFG_VALID;
  saveConfig();

  String resp = htmlHeader("Saved");
  resp += "<div class='card ok'><b>Tersimpan.</b><br>Device reboot dalam 1 detik...</div></body></html>";
  server.send(200, "text/html", resp);
  delay(1000);
  ESP.restart();
}

void handleClear() {
  clearConfig();
  server.send(200, "text/plain", "Config dihapus. Reboot...");
  delay(700);
  ESP.restart();
}

void handleTest() {
  String out = htmlHeader("Test");
  out += "<h3>Test Koneksi</h3>";

  bool okWifi = connectSTA();
  if (!okWifi) {
    out += "<div class='card warn'>Gagal konek WiFi SSID: " + String(cfg.ssid) + "</div></body></html>";
    server.send(200, "text/html", out);
    return;
  }

  bool ok = sendEvent("HEARTBEAT");
  out += "<div class='card " + String(ok ? "ok" : "warn") + "'>";
  out += "WiFi IP Slave: <b>" + WiFi.localIP().toString() + "</b><br>";
  out += "Subnet hint: <b>" + subnetHint() + "</b><br>";
  out += "Master IP: <b>" + String(cfg.masterIp) + "</b><br>";
  out += "Kirim HEARTBEAT: <b>" + String(ok ? "BERHASIL" : "GAGAL") + "</b><br>";
  out += "Jika gagal: pastikan master dan slave 1 subnet & endpoint /api/event aktif.";
  out += "</div></body></html>";

  server.send(200, "text/html", out);
}

void startAPSetup() {
  apMode = true;
  WiFi.mode(WIFI_AP);
  apName = "PANIC-SLAVE-" + String(ESP.getChipId(), HEX);
  WiFi.softAP(apName.c_str(), "12345678");

  Serial.println("\n=== AP SETUP MODE ===");
  Serial.print("AP SSID: "); Serial.println(apName);
  Serial.println("AP PASS: 12345678");
  Serial.println("Buka: http://192.168.4.1");

  server.on("/", HTTP_GET, handleSetupPage);
  server.on("/save", HTTP_POST, handleSave);
  server.on("/clear", HTTP_GET, handleClear);
  server.on("/test", HTTP_GET, handleTest);
  server.begin();
}

// ================== SETUP ==================
void setup() {
  Serial.begin(115200);
  pinMode(BTN_PIN, INPUT_PULLUP);
  pinMode(LED_PIN, OUTPUT);
  pinMode(CFG_PIN, INPUT_PULLUP);
  digitalWrite(LED_PIN, LOW);

  loadConfig();

  // hold CFG saat boot 3 detik -> paksa AP setup
  unsigned long t0 = millis();
  while (digitalRead(CFG_PIN) == LOW) {
    if (millis() - t0 > 3000) {
      clearConfig();
      break;
    }
    delay(50);
  }

  if (cfg.valid != CFG_VALID) {
    startAPSetup();
    return;
  }

  if (!connectSTA()) {
    startAPSetup();
    return;
  }

  // mode normal STA
  sendEvent("HEARTBEAT");
}

// ================== LOOP ==================
void loop() {
  // Jika AP setup mode
  if (apMode) {
    server.handleClient();
    delay(10);
    return;
  }

  // Tombol config runtime hold 5 detik -> reset config AP mode
  static unsigned long cfgHold = 0;
  bool cfgPressed = (digitalRead(CFG_PIN) == LOW);
  if (cfgPressed && cfgHold == 0) cfgHold = millis();
  if (!cfgPressed) cfgHold = 0;
  if (cfgPressed && (millis() - cfgHold > 5000)) {
    clearConfig();
    delay(300);
    ESP.restart();
  }

  // Reconnect WiFi jika putus
  if (WiFi.status() != WL_CONNECTED) {
    if (millis() - lastWifiRetry > 5000) {
      lastWifiRetry = millis();
      connectSTA();
    }
  }

  // Heartbeat periodik
  if (millis() - lastHeartbeat > 10000) {
    lastHeartbeat = millis();
    sendEvent("HEARTBEAT");
  }

  // Tombol panic logic
  bool pressed = (digitalRead(BTN_PIN) == LOW);

  if (pressed && pressStart == 0) {
    pressStart = millis();
    panicSent = false;
    clearSent = false;
  }

  if (pressed && pressStart > 0) {
    unsigned long dur = millis() - pressStart;

    // short press trigger panic (sekali)
    if (dur > 120 && !panicSent) {
      if (sendEvent("PANIC")) {
        panicSent = true;
        digitalWrite(LED_PIN, HIGH); delay(80); digitalWrite(LED_PIN, LOW);
      }
    }

    // long press 5 detik -> clear (sekali)
    if (dur >= 5000 && !clearSent) {
      if (sendEvent("CLEAR")) {
        clearSent = true;
        digitalWrite(LED_PIN, HIGH); delay(150); digitalWrite(LED_PIN, LOW);
        delay(120);
        digitalWrite(LED_PIN, HIGH); delay(150); digitalWrite(LED_PIN, LOW);
      }
      // tunggu tombol dilepas biar tidak repeat
      while (digitalRead(BTN_PIN) == LOW) delay(10);
      pressStart = 0;
      panicSent = false;
      clearSent = false;
    }
  }

  if (!pressed && pressStart > 0) {
    pressStart = 0;
    panicSent = false;
    clearSent = false;
  }

  delay(10);
}
